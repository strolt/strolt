{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "TZ",
    "PORT",
    "CI"
  ],
  "tasks": {
    "//#codegen": {
      "cache": false
    },
    "@strolt/stroltm#build": {
      "dependsOn": [
        "^build",
        "@strolt/stroltm#build:lib"
      ],
      "outputs": [
        "stroltm",
        "internal/ui/build/dist/**"
      ]
    },
    "@strolt/stroltm#build:lib": {
      "dependsOn": [
        "//#codegen",
        "^build"
      ],
      "outputs": [
        "internal/ui/build/dist/**"
      ]
    },
    "build": {
      "dependsOn": [
        "build:lib",
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "build:docker": {
      "cache": false,
      "dependsOn": [
        "//#codegen"
      ],
      "env": [
        "STROLT_BINARY_ARTIFACT"
      ]
    },
    "build:lib": {
      "dependsOn": [
        "^build:lib"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "//#codegen"
      ],
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "//#codegen"
      ]
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": [
        "//#codegen"
      ]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "//#codegen"
      ],
      "env": [
        "STROLT_BINARY_ARTIFACT",
        "STROLT_TEST_IMAGE"
      ]
    }
  }
}
