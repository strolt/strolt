root = true

[*]
charset                  = utf8
end_of_line              = lf
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = tab

[GNUmakefile]
indent_size  = 2
indent_style = tab

[Makefile]
indent_size  = 2
indent_style = tab
